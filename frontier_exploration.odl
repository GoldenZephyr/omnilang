place <- DSG.TRAVERSABILITY | semantic_class in ["road"]
frontier <- DSG.PLACES | is_frontier

connected(p1: place, p2: place) <- neighbors(p1, p2)

connected(p: place, f: frontier) <- close(p, f) # may or may not be correct

(move p1 p2) | (connected p1 p2) : (at p1) -> (at p2) (not (at p1))

(visited p): (at p) -> (visited p)

goal: (forall (f: frontier) (visited f))
